<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Recommendation artwork. HTTPS only (cleartext is off below). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Apps' TV recommendations (Watch Next + preview channels): lets the TV provider share other
         apps' searchable programs. Asked for once at first launch. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- Control Center: the Wi-Fi tile's status. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Control Center: Do Not Disturb (the user still has to grant access). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Control Center: the sleep timer fires on time. Play allows this one for any app (unlike
         USE_EXACT_ALARM, which it reserves for alarm clocks and calendars); from Android 14 the user
         grants it once, in Settings > Apps > Special app access > Alarms & reminders. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Delete App: Android's own uninstall screen, after the Delete alert. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Settings > Support > Donate: through Google Play (the billing library adds BILLING). On Android 12,
         its receiver is kept private with this signature permission, as AndroidX does. -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <!-- Package visibility: apps that can be launched from a home screen, home apps, the Settings
         screen for choosing one, the TV provider, and what opens web and Google Play links. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Home apps: to tell whether Google TV's own home screen is still on. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.settings.HOME_SETTINGS" />
        </intent>
        <provider android:authorities="android.media.tv" />
        <!-- Settings > Support: whether there's a browser for the website, Google Play for its page -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:banner="@drawable/banner"
        android:enableOnBackInvokedCallback="false"
        tools:targetApi="33"
        android:hasFragileUserData="false"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:theme="@style/Launcher"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Force-lock only: lets Power Off and the Sleep Timer put the TV to sleep. Only the system can bind it. -->
        <receiver
            android:name=".PowerAdmin"
            android:description="@string/power_admin_description"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/power_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Sleep timer alarm; only our own PendingIntent can reach it. -->
        <receiver
            android:name=".SleepTimer"
            android:exported="false" />
        <!-- Google Play billing's alternative-billing screen needs AndroidX, which isn't here; it's unused. -->
        <activity
            android:name="com.android.billingclient.api.ProxyBillingActivityV2"
            tools:node="remove" />
    </application>
</manifest>
