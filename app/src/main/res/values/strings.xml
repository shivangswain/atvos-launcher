    <!-- Setup. It shows on the first launch, and from Settings when another app is the home app. -->
    <string name="setup_welcome">Welcome to atvOS Launcher</string>
    <string name="setup_welcome_body">A fast, minimal home screen for your TV. Setting it up takes a minute, right here on the TV.</string>
    <string name="setup_get_started">Get Started</string>
    <string name="setup_not_now">Not Now</string>
    <string name="setup_back">Back</string>
    <!-- "Android TV OS build" is the row name in the Settings app of the TV. Use the same name. -->
    <string name="setup_developer_title">Turn On Developer Options</string>
    <string name="setup_developer_body">Select Android TV OS build seven times, until the TV says you\'re now a developer. Then press Back to come back here.</string>
    <string name="setup_open_about">Open About</string>
    <string name="setup_debugging_title">Turn On USB Debugging</string>
    <string name="setup_debugging_body">Turn on USB debugging, and confirm when the TV asks. atvOS Launcher uses it once, to take over the Home button. Then press Back to come back here.</string>
    <string name="setup_open_developer">Open Developer Options</string>
    <string name="setup_allow_title">Allow USB Debugging</string>
    <string name="setup_allow_body">Select Set Up. When the TV asks, check that its code is the same as the code in this picture, then select Allow.</string>
    <string name="setup_set_up">Set Up</string>
    <string name="setup_try_again">Try Again</string>
    <string name="setup_pick_title">Make It Your Home Screen</string>
    <string name="setup_pick_body">Choose atvOS Launcher in the list that opens.</string>
    <string name="setup_pick_button">Choose Home App</string>
    <string name="setup_account_title">Add Your Profile Picture</string>
    <string name="setup_account_body">Choose your Google account to show its picture on the home screen. This is optional, and you can change it any time in Settings.</string>
    <string name="setup_choose_account">Choose Account</string>
    <string name="setup_done_title">You\'re All Set</string>
    <string name="setup_done_body">atvOS Launcher is your home screen. Press Home any time to come back to it.</string>
    <string name="setup_done_body_not_home">atvOS Launcher is ready. You can make it your home screen any time from Settings in Control Center.</string>
    <!-- Done, after the TV's own debugging set up the Home button. USB debugging is still on. -->
    <string name="setup_done_body_debugging">atvOS Launcher is your home screen. You can now turn off USB debugging in Developer options. Turn it on again only to restore the TV\'s own home screen.</string>
    <string name="setup_go_home">Go to Home Screen</string>
    <string name="setup_tv_connecting">Connecting to this TV…</string>
    <string name="setup_tv_approve">Approve “Allow USB debugging” on your TV…</string>
    <string name="setup_tv_working">Updating the home screen…</string>
    <string name="setup_tv_done">Done. atvOS Launcher is your home screen.</string>
    <string name="setup_tv_restored">Restored the TV\'s own home screen.</string>
    <string name="setup_tv_enable_debug">Turn on USB debugging in Developer options, then try again.</string>
    <string name="setup_tv_unreachable">Couldn\'t reach this TV\'s debugging. Check that USB debugging is on, then try again.</string>
    <string name="setup_tv_denied">Debugging wasn\'t approved on the TV. Try again and select Allow.</string>
    <string name="setup_tv_failed">The TV didn\'t let atvOS Launcher change the home screen.</string>
