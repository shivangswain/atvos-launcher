    <string name="settings_appearance">Appearance</string>
    <string name="settings_appearance_about">Select Light or Dark to change the appearance of Settings and of the rows of programs on the top shelf.</string>
    <string name="settings_light">Light</string>
    <string name="settings_dark">Dark</string>
    <string name="settings_privacy">Privacy</string>
    <string name="settings_privacy_about">atvOS Launcher keeps everything on this TV. It collects nothing and shares nothing: your profile photo comes straight from Google, and donations are handled by Google Play. Read the full privacy policy at atvos.tv/privacy on your phone or computer.</string>
    <!-- The address of the privacy policy. It must be the same as the privacy policy address in Play Console. -->
    <string name="settings_privacy_address" translatable="false">atvos.tv/privacy</string>
    <string name="settings_acknowledgements">Acknowledgements</string>
    <string name="settings_acknowledgements_about">Icons from Google\'s Material Symbols, under the Apache License 2.0. Donations through the Google Play Billing Library.</string>
    <!-- A section title. It shows in capital letters. -->
    <string name="settings_date_time">Date &amp; Time</string>
    <string name="settings_time_format">Time Format</string>
    <string name="settings_time_format_about">How the clock beside your profile picture shows the time.</string>
    <string name="settings_12_hour">12-Hour</string>
    <string name="settings_24_hour">24-Hour</string>
    <string name="settings_profiles">Profiles and Accounts</string>
    <string name="settings_account">Account</string>
    <string name="settings_account_about">The Google account whose picture appears beside the clock. Select to choose an account.</string>
    <string name="settings_picture">Profile Picture</string>
    <string name="settings_picture_about">What appears beside the clock: your Google account\'s photo, its initial, or neither.</string>
    <string name="settings_picture_photo">Google Photo</string>
    <string name="settings_picture_initial">Initial</string>
    <string name="settings_uninstall">Uninstall</string>
    <string name="settings_restore">Restore Default Launcher</string>
    <string name="settings_restore_about">Turns the TV\'s own home screen back on. Do this before uninstalling atvOS Launcher.</string>
    <string name="settings_restore_not_needed">The TV\'s own home screen is already on.</string>
    <string name="settings_release_power">Remove Power Control</string>
    <string name="settings_release_power_about">Do this before uninstalling atvOS Launcher. Power Off and the Sleep Timer stop working until you use Power Off again.</string>
