---
// The page for an address that does not exist. Cloudflare Pages serves 404.html with status 404.
import Base from "../layouts/Base.astro";
import Chevron from "../components/Chevron.astro";
---
<Base title="Page not found · atvOS Launcher" description="This page does not exist." noindex>
  <section class="doc">
    <div class="wrap text-col center">
      <h1>Page not found</h1>
      <p class="lead">The page that you asked for isn't here.</p>
      <div class="actions"><a class="more" href="/">Go to atvos.tv<Chevron /></a></div>
    </div>
  </section>
</Base>
