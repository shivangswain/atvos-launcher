---
// atvos.tv: what atvOS Launcher is, how to set it up, and answers to common questions.
import Base from "../layouts/Base.astro";
import HomeMock from "../components/HomeMock.astro";
import Icon from "../components/Icon.astro";
import Chevron from "../components/Chevron.astro";
import { site } from "../site";

const features = [
  {
    icon: "tv",
    title: "Top Shelf",
    body: "Move to an app in the dock and its top shelf fills the screen.",
  },
  {
    icon: "apps",
    title: "Your layout",
    body: "Put your favourite apps in the dock, reorder the rest, make folders and hide the apps that you don't use.",
  },
  {
    icon: "switches",
    title: "Control Center",
    body: "Frequently used shortcuts that let you change settings quickly, without getting in the way.",
  },
  {
    icon: "settings",
    title: "Glass, made for TVs",
    body: "Quickly change the look and feel of the launcher, while it stays familiar and easy to use.",
  },
  {
    icon: "accessibility",
    title: "TalkBack",
    body: "Every tile, button and menu option is read aloud as you reach it.",
  },
  {
    icon: "lock",
    title: "Private",
    body: "No ads or analytics. atvOS Launcher uses your Google account only for your profile photo.",
  },
];

// Structured data (schema.org) for search engines: the name of the site, and the app with its price and maker.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${site.url}/#website`, name: site.name, alternateName: "atvOS", url: `${site.url}/` },
    {
      "@type": "SoftwareApplication",
      name: site.name,
      url: `${site.url}/`,
      image: `${site.url}/social/og.png`,
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Android 12 or later (Google TV, Android TV)",
      description: "A free, open-source home screen for Google TV and Android TV, inspired by the tvOS Home Screen.",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      license: "https://www.gnu.org/licenses/gpl-3.0.html",
      codeRepository: site.github,
      ...(site.onPlay ? { downloadUrl: site.play, installUrl: site.play } : {}),
      author: { "@type": "Person", name: site.developer_name, url: site.developer_url },
      publisher: { "@type": "Person", name: site.developer_name, url: site.developer_url },
    },
  ],
};

const steps = [
  {
    title: "Turn on Developer options",
    body: "atvOS opens the TV's About screen. Select the build row seven times.",
  },
  {
    title: "Turn on USB debugging",
    body: "atvOS opens Developer options for you.",
  },
  {
    title: "Allow USB debugging",
    body: "When the TV asks, select Allow. atvOS becomes the home screen.",
  },
  {
    title: "Hold Home for Control Center",
    body: "Optional. Turn on atvOS Launcher Remote Buttons in Accessibility.",
  },
  {
    title: "Add your profile picture",
    body: "Completely optional. Choose your Google account to show its profile picture on the home screen.",
  },
];
---
<Base
  title="atvOS Launcher: a home screen for Google TV"
  description="atvOS Launcher is a free, open-source home screen for Google TV, inspired by the tvOS Home Screen."
  current="overview"
>
  <!-- "<" as \u003c, so that no text in the data can end the script element. -->
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
  <section class="hero">
    <div class="wrap center text-col">
      <h1>The home screen your TV deserves</h1>
      <p class="lead">
        atvOS Launcher gives your Google TV a clean, fast and visually stunning home screen, inspired by tvOS. It
        is free and open source, and it keeps everything on your TV.
      </p>
      <div class="actions">
        {site.onPlay ? (
          <a class="pill" href={site.play}>Get it on Google Play</a>
        ) : (
          <span class="pill soon">Coming soon to Google Play</span>
        )}
        <a class="more" href={site.github}>View the source code<Chevron /></a>
      </div>
    </div>
    <HomeMock />
  </section>

  <section class="section" id="features">
    <div class="wrap">
      <div class="section-head text-col center">
        <h2>Get to know atvOS</h2>
        <p class="lead">Everything that you watch, one press away.</p>
      </div>
      <div class="features">
        {features.map((f) => (
          <article class="feature">
            <span class="glyph"><Icon name={f.icon} /></span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt" id="setup">
    <div class="wrap text-col">
      <div class="section-head">
        <h2>Set up in a few minutes</h2>
        <p class="lead">
          You need a Google TV or Android TV device with Android 12 or later. On first launch, atvOS shows each step
          with a picture of the TV's Settings screen, opens that screen for you and skips the steps that are already
          done.
        </p>
      </div>
      <ol class="steps">
        {steps.map((s) => (
          <li>
            <div>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="card-box note">
        <h3>Why USB debugging?</h3>
        <p>
          The built-in home screens of Google TV and Android TV keep the Home button, even after you choose a
          different home app. atvOS turns the built-in home screen off through the TV's own debugging connection,
          inside the TV. It sends only two fixed commands: one turns the built-in home screen off, and one turns it
          back on.
        </p>
        <p>
          Don't want developer settings? Select Not Now, and atvOS offers Accessibility instead: Remote Buttons opens
          atvOS when you press Home and when the TV's home screen opens, which can show for a moment first. Switch any
          time in atvOS Settings, under Home Screen.
        </p>
        <p>
          When setup is done, you can turn USB debugging off again. On a TV that lets you choose the home app, atvOS
          opens Android's home app setting instead, and needs no debugging at all.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="support">
    <div class="wrap text-col">
      <div class="section-head">
        <h2>Support</h2>
      </div>
      <div class="faq">
        <details>
          <summary>How do I get my TV's own home screen back?<Icon name="chevron" /></summary>
          <div class="answer">
            <ol>
              <li>
                If you set up atvOS with USB debugging and turned it off afterwards, turn it on again in Developer
                options. Then open atvOS Settings, select Uninstall, then Restore Default Launcher.
              </li>
              <li>Select Remove Power Control. Android can't uninstall an app with device admin access.</li>
              <li>Open Support, select App Info, then Uninstall.</li>
            </ol>
            <p>To open atvOS Settings, select the clock, then the switches button in the Control Center.</p>
          </div>
        </details>
        <details>
          <summary>Which devices does atvOS work on?<Icon name="chevron" /></summary>
          <div class="answer">
            <p>
              Google TV and Android TV devices with Android 12 or later: TVs, streaming sticks and set-top boxes.
            </p>
          </div>
        </details>
        <details>
          <summary>What do the Home, Settings and Guide buttons do?<Icon name="chevron" /></summary>
          <div class="answer">
            <p>
              With Remote Buttons on, holding Home opens the Control Center, and the Settings button opens the TV's
              settings. Remote Buttons is an accessibility service that you turn on in the TV's Accessibility settings.
              It sees only the remote's buttons, acts only on Home and Settings, and passes every other button on. It
              doesn't read the screen, and nothing is stored or shared. Turn it off in atvOS Settings, under Home
              Screen.
            </p>
            <p>
              The Guide button opens a panel of the TV's built-in home screen, so it does nothing while atvOS replaces
              it. Restore Default Launcher brings it back.
            </p>
          </div>
        </details>
        <details>
          <summary>Why is a top shelf empty?<Icon name="chevron" /></summary>
          <div class="answer">
            <p>
              A top shelf shows what an app shares with the TV, and some apps share nothing. atvOS also needs access
              to app recommendations: the TV asks for it when the first setup ends. If you didn't allow it, turn it on
              in the TV's Settings, in the permissions of atvOS Launcher.
            </p>
          </div>
        </details>
        <details>
          <summary>Does atvOS collect my data?<Icon name="chevron" /></summary>
          <div class="answer">
            <p>No. There's no sign-up, no ads and no analytics. Read the <a href="/privacy">Privacy Policy</a>.</p>
          </div>
        </details>
        <details>
          <summary>How do I report a problem or ask for a feature?<Icon name="chevron" /></summary>
          <div class="answer">
            <p>
              Open an issue on <a href={site.issues}>GitHub</a>. Say which TV you have, its Android version and what
              you did before the problem.
            </p>
          </div>
        </details>
        <details>
          <summary>Is atvOS made by Apple?<Icon name="chevron" /></summary>
          <div class="answer">
            <p>
              No. atvOS Launcher is an independent project, inspired by the tvOS Home Screen. It is not affiliated with
              or endorsed by Apple or Google.
            </p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="pair">
        <div class="card-box">
          <span class="glyph"><Icon name="code" /></span>
          <h3>Free and open source</h3>
          <p>
            atvOS Launcher is free software under the GNU General Public License v3.0. Read the code, build it
            yourself or help make it better.
          </p>
          <a class="more" href={site.github}>View on GitHub<Chevron /></a>
        </div>
        <div class="card-box">
          <span class="glyph"><Icon name="heart" /></span>
          <h3>Support the project</h3>
          <p>
            If you enjoy atvOS, you can donate from atvOS Settings, under Support, then Donate. Donations are completely
            optional: atvOS is the same for everyone.
          </p>
          <a class="more" href={site.paypal}>Or buy me a coffee<Chevron /></a>
        </div>
      </div>
    </div>
  </section>
</Base>
