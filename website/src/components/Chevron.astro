---
// The chevron after a link. The drawing fills its box, and the box stands on the text baseline at the height of a
// capital letter, so the chevron lines up with the text the same way in every browser.
---
<svg
  class="chevron"
  viewBox="0 0 8 14"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"><path d="M1.6 1.4 6.5 7l-4.9 5.6" /></svg>
